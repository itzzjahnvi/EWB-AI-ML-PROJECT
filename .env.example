# Copy to .env and adjust. All values are optional; defaults are shown.

# SQLite file location (persistent). Relative paths are relative to where you start the app.
DATABASE_URL=sqlite:///./data/students.db

# --- Optional bonus: local AI assistant (Ollama) ---
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
AI_MAX_RECORDS=25
